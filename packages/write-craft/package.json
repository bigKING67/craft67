{
  "name": "@bigking67/write-craft",
  "version": "0.2.1",
  "private": true,
  "description": "Agent Skill for turning complex technical proposals into clear, decision-ready documents for non-technical readers, and for auditing and rewriting project READMEs.",
  "license": "MIT",
  "author": "bigKING67",
  "homepage": "https://github.com/bigKING67/write-craft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigKING67/write-craft.git"
  },
  "files": [
    "skills/write-craft",
    "LICENSE",
    "LICENSES",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "VERSION"
  ],
  "keywords": [
    "pi-package",
    "agent-skill",
    "decision-writing",
    "plain-language",
    "technical-communication",
    "executive-communication",
    "readme"
  ],
  "pi": {
    "skills": [
      "skills/write-craft"
    ]
  },
  "scripts": {
    "validate": "python3 scripts/validate.py",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "package:check": "python3 scripts/package_check.py",
    "release:check": "python3 scripts/release_check.py",
    "upstream:status": "python3 scripts/upstream_status.py --json"
  }
}
