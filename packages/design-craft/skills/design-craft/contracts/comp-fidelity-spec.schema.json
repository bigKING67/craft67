{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-craft.local/contracts/comp-fidelity-spec.schema.json",
  "title": "Design Craft Comp Fidelity Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "coordinate_space",
    "changed_pixel_delta",
    "regions"
  ],
  "properties": {
    "schema": { "const": "design-craft.comp-fidelity-spec.v1" },
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "coordinate_space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "changed_pixel_delta": { "type": "number", "minimum": 0, "maximum": 1 },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "box", "salience", "dimensions", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "box": {
            "type": "array",
            "prefixItems": [
              { "type": "integer", "minimum": 0 },
              { "type": "integer", "minimum": 0 },
              { "type": "integer", "minimum": 1 },
              { "type": "integer", "minimum": 1 }
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "salience": { "enum": ["primary", "secondary", "supporting"] },
          "dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["geometry", "type", "material", "ground", "controls", "content"] }
          },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "advisory_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "mean_delta": { "type": "number", "minimum": 0, "maximum": 1 },
        "changed_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "rmse": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
