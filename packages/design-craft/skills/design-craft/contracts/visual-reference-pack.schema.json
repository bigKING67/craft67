{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/design-craft/skills/design-craft/contracts/visual-reference-pack.schema.json",
  "title": "design-craft visual reference pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "task", "references", "blocking_reasons", "created_at"],
  "properties": {
    "schema": {"const": "design-craft.visual-reference-pack.v1"},
    "status": {"enum": ["ready", "incomplete"]},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_mode", "audience", "primary_job", "authority_refs"],
      "properties": {
        "surface_mode": {"enum": ["Persuade", "Operate", "Read", "Experience"]},
        "audience": {"type": "string", "minLength": 1},
        "primary_job": {"type": "string", "minLength": 1},
        "authority_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id", "role", "adapt", "reject", "unverified"],
        "properties": {
          "card_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["structure", "responsive", "tone", "interaction", "counter_reference"]},
          "adapt": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "reject": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "unverified": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "blocking_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"properties": {"references": {"minItems": 1}}}
    }
  ]
}
