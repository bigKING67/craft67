# Keep source-derived evidence hashes stable across Windows and Unix checkouts.
* text=auto eol=lf

# Preserve model-authored Markdown hard breaks in hash-bound comparative
# evidence, including archived tranches under history/.
evals/comparative/**/blind-packet.md whitespace=-blank-at-eol,-blank-at-eof
evals/comparative/**/output.*.md whitespace=-blank-at-eol,-blank-at-eof

# Preserve model-authored Markdown hard breaks in hash-bound cross-agent
# evidence for every host, including archived tranches under history/.
evals/cross-agent/**/*-output.md whitespace=-blank-at-eol,-blank-at-eof
