  "adjudication": {
    "minimumIndependentReviewers": 2,
    "thirdReviewerTriggers": [
      "any high-confidence character disagreement at a target locus",
      "either of the first two reviewers marks a target image partial or no",
      "either reviewer scores fail on controls",
      "the first two reviewers do not produce the same target character sequence"
    ],
    "characterNormalization": "Remove whitespace only. Traditional and variant characters remain distinct unless the coordinator documents a glyph-equivalence decision after review.",
    "punctuation": "Score printed punctuation separately from characters; punctuation disagreement does not silently alter character agreement.",
    "controlCalibration": {
      "pass": "2 of 2 control character sequences match",
      "conditional": "1 of 2 control character sequences matches",
      "fail": "0 of 2 control character sequences match",
      "rule": "A fail reviewer cannot be the sole support for a target; if only two reviewers were collected and either fails, obtain a third."
    },
    "targetAcceptance": "Accept a target character reading only when at least two independent usable responses agree exactly, at least one agreeing reviewer passes both controls, and no other control-passing reviewer gives a conflicting high-confidence reading.",
    "unresolvedRule": "Otherwise retain the existing reading as provisional and record the locus as unresolved; do not choose by simple majority or contextual smoothness.",
    "tool": "npm run blind-review:adjudicate -- --response <a.json> --response <b.json> [--response <c.json>] [--out <result.json>]"
  },
  "notClaimed": [
