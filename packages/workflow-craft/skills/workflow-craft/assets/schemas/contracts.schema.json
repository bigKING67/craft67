{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Craft v2 exchange contracts",
  "description": "Structural interchange contracts; neither identity attestation nor merge authorization. Extra observation fields are allowed. TaskRecord, VerificationRecord and Handoff live in .team-workflow/tasks/<type>-<number> or local-<slug>/ and are committed with the task branch; WorkPacket and VerificationEvidence stay in ignored local state. v1 artifacts are not read.",
  "$defs": {
    "TaskRef": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "provider",
            "instance",
            "repository",
            "type",
            "number"
          ],
          "properties": {
            "provider": {
              "enum": [
                "gitea",
                "cnb"
              ]
            },
            "instance": {
              "type": "string",
              "format": "uri"
            },
            "repository": {
              "type": "string"
            },
            "type": {
              "enum": [
                "issue",
                "pr"
              ]
            },
            "number": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "project_id",
            "type",
            "slug"
          ],
          "properties": {
            "provider": {
              "const": "local"
            },
            "project_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "type": {
              "const": "local"
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            }
          }
        }
      ]
    },
    "CodeState": {
      "type": "object",
      "required": [
        "head",
        "base",
        "base_ref",
        "dirty",
        "tree_sha256",
        "fingerprint_complete"
      ],
      "properties": {
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "fingerprint_complete": {
          "type": "boolean"
        },
        "tree_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_is_ancestor": {
          "type": "boolean"
        }
      },
      "description": "tree_sha256 is the content identity of the working tree excluding .team-workflow/tasks/; equal content hashes equally whether committed or not."
    },
    "CheckResult": {
      "type": "object",
      "required": [
        "check",
        "argv",
        "cwd",
        "started_at",
        "ended_at",
        "exit_code",
        "status"
      ],
      "properties": {
        "check": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "incomplete"
          ]
        },
        "log_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_sha256": {
          "type": "string"
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "WorkPacket": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "created_at",
        "task_ref",
        "workflow_owner",
        "contract",
        "sources",
        "platform",
        "code",
        "policy_sha256",
        "authority"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "WorkPacket"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_ref": {
          "$ref": "#/$defs/TaskRef"
        },
        "workflow_owner": {
          "enum": [
            "workflow-craft",
            "trellis",
            "team-workflow-craft"
          ]
        },
        "contract": {
          "type": [
            "object",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "platform": {
          "type": "object"
        },
        "code": {
          "$ref": "#/$defs/CodeState"
        },
        "policy_sha256": {
          "type": "string"
        },
        "authority": {
          "const": "derived_snapshot"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        }
      }
    },
    "VerificationEvidence": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "created_at",
        "task_ref",
        "before",
        "after",
        "policy_sha256",
        "toolchain",
        "checks",
        "status",
        "provenance",
        "ci_refs",
        "drift"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "VerificationEvidence"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "$ref": "#/$defs/CodeState"
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeState"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_sha256": {
          "type": "string"
        },
        "toolchain": {
          "type": "object"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckResult"
          }
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "incomplete"
          ]
        },
        "provenance": {
          "const": "local_execution_unattested"
        },
        "ci_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "contract_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Handoff": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "created_at",
        "task_ref",
        "task_revision",
        "contract_sha256",
        "code",
        "done",
        "remaining",
        "next_steps",
        "acceptance",
        "checks",
        "platform",
        "readiness",
        "blockers",
        "unknowns",
        "merge_authorized",
        "published"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "Handoff"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_ref": {
          "$ref": "#/$defs/TaskRef"
        },
        "code": {
          "$ref": "#/$defs/CodeState"
        },
        "done": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remaining": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platform": {
          "type": "object"
        },
        "readiness": {
          "enum": [
            "not_ready",
            "advisory_ready",
            "unknown"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merge_authorized": {
          "const": false
        },
        "published": {
          "const": false
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "prepared_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrator": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_revision": {
          "type": "integer",
          "minimum": 1
        },
        "contract_sha256": {
          "type": "string"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcceptanceItem"
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "evidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run",
                  "incomplete",
                  "stale",
                  "missing"
                ]
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "readiness_scope": {
          "enum": [
            "local_task",
            "platform_handoff"
          ],
          "description": "Local task continuation or platform handoff; neither authorizes merge."
        }
      },
      "description": "handoff.json beside handoff.md; the latest handoff for the task, history kept by Git."
    },
    "Actor": {
      "type": "object",
      "description": "Fresh local observation of a platform account and effective Git identity; not authentication attestation or task ownership.",
      "required": [
        "observed_at",
        "platform",
        "git",
        "trust"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "platform": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "provider",
                "instance",
                "status",
                "observed_at",
                "data"
              ],
              "properties": {
                "provider": {
                  "enum": [
                    "gitea",
                    "cnb"
                  ]
                },
                "instance": {
                  "type": "string",
                  "format": "uri"
                },
                "status": {
                  "type": "string"
                },
                "observed_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "data": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            },
            {
              "type": "object",
              "required": [
                "provider",
                "instance",
                "status",
                "observed_at",
                "data"
              ],
              "properties": {
                "provider": {
                  "const": null
                },
                "instance": {
                  "const": null
                },
                "status": {
                  "const": "not_configured"
                },
                "observed_at": {
                  "const": null
                },
                "data": {
                  "const": null
                }
              }
            }
          ]
        },
        "git": {
          "type": "object",
          "required": [
            "status",
            "source",
            "trust",
            "author",
            "committer"
          ]
        },
        "trust": {
          "const": "local_observation_not_identity_attestation"
        }
      }
    },
    "AcceptanceItem": {
      "type": "object",
      "required": [
        "id",
        "text",
        "checks"
      ],
      "description": "Numbered acceptance criterion. Empty checks means human review; it is never auto-verified.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "verified",
            "pending",
            "failed",
            "needs_review",
            "unknown_check"
          ]
        }
      }
    },
    "TaskRecord": {
      "type": "object",
      "description": "task.json: recorded contract plus optional local execution lifecycle; never platform assignment or approval. Contract changes require prepare --update-contract; execution changes use task commands.",
      "required": [
        "schema_version",
        "kind",
        "task_ref",
        "revision",
        "contract",
        "acceptance",
        "sources",
        "contract_sha256",
        "recorded_by",
        "recorded_at",
        "history"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "TaskRecord"
        },
        "task_ref": {
          "$ref": "#/$defs/TaskRef"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contract": {
          "type": [
            "object",
            "null"
          ]
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcceptanceItem"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "contract_sha256": {
          "type": "string",
          "description": "SHA-256 of canonical {contract, sources}"
        },
        "recorded_by": {
          "$ref": "#/$defs/Actor"
        },
        "recorded_at": {
          "type": "string"
        },
        "history": {
          "type": "array"
        },
        "execution": {
          "$ref": "#/$defs/TaskExecution"
        }
      }
    },
    "VerificationRecord": {
      "type": "object",
      "description": "evidence/<timestamp>-<run_id>.json: commit-safe summary of one verify run; no local paths, remotes or output.",
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "created_at",
        "task_ref",
        "contract_sha256",
        "policy_sha256",
        "toolchain",
        "provenance",
        "status",
        "drift",
        "code",
        "checks"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "VerificationRecord"
        },
        "run_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "task_ref": {
          "$ref": "#/$defs/TaskRef"
        },
        "contract_sha256": {
          "type": "string"
        },
        "policy_sha256": {
          "type": "string"
        },
        "toolchain": {
          "type": "object"
        },
        "actor": {
          "$ref": "#/$defs/Actor",
          "description": "May be absent in legacy v2 records; absence never proves attribution."
        },
        "provenance": {
          "const": "local_execution_unattested"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "incomplete"
          ]
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/CodeState"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckSummary"
          }
        }
      }
    },
    "CheckSummary": {
      "type": "object",
      "required": [
        "check",
        "cwd",
        "started_at",
        "ended_at",
        "exit_code",
        "status"
      ],
      "properties": {
        "check": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "incomplete"
          ]
        },
        "log_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "command_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "Portable check summary. command_sha256 binds canonical {argv,cwd}; raw argv stays in local evidence. Legacy v2 argv records remain readable; check flags absolute legacy command paths.",
      "anyOf": [
        {
          "required": [
            "command_sha256"
          ]
        },
        {
          "required": [
            "argv"
          ]
        }
      ]
    },
    "TaskExecution": {
      "type": "object",
      "required": [
        "schema_version",
        "state",
        "parent",
        "history",
        "completion"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "state": {
          "enum": [
            "planning",
            "in_progress",
            "paused",
            "completed",
            "archived"
          ]
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/TaskRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "action",
              "state",
              "at",
              "actor"
            ]
          }
        },
        "completion": {
          "type": [
            "object",
            "null"
          ],
          "description": "Local completion evidence bound to contract, code, policy, toolchain, child completions and explicit review sources; not authenticated approval."
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TaskRef"
    },
    {
      "$ref": "#/$defs/WorkPacket"
    },
    {
      "$ref": "#/$defs/VerificationEvidence"
    },
    {
      "$ref": "#/$defs/TaskRecord"
    },
    {
      "$ref": "#/$defs/VerificationRecord"
    },
    {
      "$ref": "#/$defs/Handoff"
    }
  ]
}
