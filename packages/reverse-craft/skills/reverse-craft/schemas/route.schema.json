{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/reverse-craft/schemas/route.schema.json",
  "title": "Reverse Craft route result v1",
  "type": "object",
  "required": ["schema", "hint", "primary", "secondary", "ambiguous", "tied", "candidate_count", "routing_source"],
  "properties": {
    "schema": {"const": "reverse-craft.route.v1"},
    "hint": {"type": "string"},
    "artifact": {"type": ["object", "null"]},
    "primary": {"$ref": "#/$defs/candidate"},
    "secondary": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "ambiguous": {"type": "boolean"},
    "tied": {"type": "array", "items": {"pattern": "^(?:R(?:[0-9]|[1-3][0-9]|4[01])|R44)$"}},
    "candidate_count": {"type": "integer", "minimum": 1},
    "routing_source": {
      "type": "object",
      "required": ["schema_version", "routes", "sha256"],
      "properties": {
        "schema_version": {"type": "string"},
        "routes": {"const": 43},
        "sha256": {"pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["id", "label", "score", "priority", "matched_rules"],
      "properties": {
        "id": {"pattern": "^(?:R(?:[0-9]|[1-3][0-9]|4[01])|R44)$"},
        "label": {"type": "string", "minLength": 1},
        "score": {"type": "integer", "minimum": 0},
        "priority": {"type": "integer", "minimum": 0},
        "matched_rules": {"type": "array"},
        "slug": {"type": "string"},
        "family": {"type": "string"},
        "reference": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
