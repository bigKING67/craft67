{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/creative-craft/schemas/concept-routes.schema.json",
  "title": "Creative Craft Concept Routes v1",
  "type": "object",
  "required": [
    "schema_version",
    "brief_id",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": "creative-craft.concept-routes.v1"
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "name",
          "premise",
          "mechanism",
          "hook",
          "architecture",
          "visual_world",
          "hero_moment",
          "why_it_may_win",
          "decision"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "premise": {
            "type": "string",
            "minLength": 1
          },
          "tension_or_insight": {
            "type": "string"
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "hook": {
            "type": "string",
            "minLength": 1
          },
          "architecture": {
            "type": "string",
            "minLength": 1
          },
          "visual_world": {
            "type": "string",
            "minLength": 1
          },
          "copy_world": {
            "type": "string"
          },
          "sound_world": {
            "type": "string"
          },
          "hero_moment": {
            "type": "string",
            "minLength": 1
          },
          "asset_system": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feasibility": {
            "type": "object"
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why_it_may_win": {
            "type": "string",
            "minLength": 1
          },
          "falsification": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "SELECT",
              "SELECT_FOR_TEST",
              "HOLD",
              "MERGE_ELEMENT",
              "REWORK",
              "REJECT"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
