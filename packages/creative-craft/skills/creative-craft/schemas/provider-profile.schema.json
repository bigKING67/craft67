{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/creative-craft/schemas/provider-profile.schema.json",
  "title": "Creative Craft Provider Profile v1",
  "type": "object",
  "required": ["schema_version", "profile_id", "provider", "model", "verified_at", "authority", "sources", "availability", "capabilities", "workflow_guidance", "known_limitations"],
  "properties": {
    "schema_version": {"const": "creative-craft.provider.v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "snapshot": {"type": "string"},
    "verified_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "authority": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "availability": {"type": "object"},
    "capabilities": {"type": "object"},
    "workflow_guidance": {"type": "object"},
    "known_limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
