{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/creative-craft/schemas/production-plan.schema.json",
  "title": "Creative Craft Production Plan v1",
  "description": "Beat-level video plan: source kind per beat, evidence-backed footage selections, generation bindings, and delivery promises. Check-kind and evidence-proximity rules are enforced by semantic validation.",
  "type": "object",
  "required": ["schema_version", "plan_id", "title", "brief_ref", "intended_use", "output", "delivery_promises", "beats"],
  "properties": {
    "schema_version": {"const": "creative-craft.production-plan.v1"},
    "plan_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "brief_ref": {
      "type": ["object", "null"],
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "intended_use": {"type": "string", "minLength": 1},
    "output": {
      "type": "object",
      "required": ["duration_seconds_target", "ratio", "language"],
      "properties": {
        "duration_seconds_target": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
        "ratio": {"enum": ["9:16", "16:9", "1:1", "4:5"]},
        "language": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "delivery_promises": {"type": "array", "items": {"$ref": "#/$defs/promise"}},
    "beats": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/beat"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "promise": {
      "type": "object",
      "required": ["id", "statement", "check"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "check": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["manual", "duration_range", "captions_present", "max_generated_share"]},
            "min": {"type": "number", "minimum": 0},
            "max": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["modality", "start_seconds", "end_seconds", "excerpt", "raw_score", "method"],
      "properties": {
        "modality": {"enum": ["asr", "ocr", "frame", "inspected_av", "inference"]},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "minimum": 0},
        "excerpt": {"type": "string", "minLength": 1},
        "raw_score": {"type": ["number", "null"]},
        "method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "beat": {
      "type": "object",
      "required": ["id", "role", "purpose", "duration_seconds", "source_kind", "requirement", "hard_constraints", "selection", "generation_ref", "locked"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
        "source_kind": {"enum": ["footage", "generate", "graphic", "record", "tbd"]},
        "requirement": {"type": "string", "minLength": 1},
        "hard_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "selection": {
          "type": ["object", "null"],
          "required": ["asset_ref", "source_start_seconds", "source_end_seconds", "evidence", "reason", "status"],
          "properties": {
            "asset_ref": {"type": "string", "minLength": 1},
            "source_start_seconds": {"type": "number", "minimum": 0},
            "source_end_seconds": {"type": "number", "minimum": 0},
            "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
            "reason": {"type": "string", "minLength": 1},
            "status": {"enum": ["candidate", "confirmed"]}
          },
          "additionalProperties": false
        },
        "generation_ref": {
          "type": ["object", "null"],
          "required": ["job_path", "receipt_path"],
          "properties": {
            "job_path": {"type": "string", "minLength": 1},
            "receipt_path": {"type": ["string", "null"], "minLength": 1}
          },
          "additionalProperties": false
        },
        "locked": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
