{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/creative-craft/schemas/image-job-v2.schema.json",
  "title": "Creative Craft Image Job v2",
  "type": "object",
  "required": ["schema_version", "job_id", "brief_id", "direction_id", "selected_route_id", "declared_status", "provider_profile", "execution_surface", "task_type", "execution_mode", "intended_use", "asset_refs", "canvas", "prompt", "inspection", "rights"],
  "properties": {
    "schema_version": {"const": "creative-craft.image-job.v2"},
    "job_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "direction_id": {"type": "string", "minLength": 1},
    "selected_route_id": {"type": "string", "minLength": 1},
    "copy_sheet_id": {"type": "string", "minLength": 1},
    "copy_unit_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "declared_status": {"enum": ["draft", "ready", "superseded"]},
    "provider_profile": {"type": "string", "minLength": 1},
    "execution_surface": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["generate", "edit"]},
    "execution_mode": {"enum": ["single_turn", "multi_turn"]},
    "intended_use": {"type": "string", "minLength": 1},
    "asset_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "canvas": {
      "type": "object",
      "required": ["size", "quality", "format", "compression", "background", "variants"],
      "properties": {
        "size": {"type": "string", "minLength": 1},
        "quality": {"enum": ["low", "medium", "high", "auto"]},
        "format": {"enum": ["png", "jpeg", "webp"]},
        "compression": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "background": {"enum": ["opaque", "auto", "transparent"]},
        "variants": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "required": ["scene", "subject", "composition", "lighting", "materials_style", "exact_text", "references", "change", "preserve", "constraints", "exclude"],
      "properties": {
        "scene": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "action": {"type": "string"},
        "composition": {"type": "string", "minLength": 1},
        "lighting": {"type": "string", "minLength": 1},
        "materials_style": {"type": "string", "minLength": 1},
        "exact_text": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": {"type": "string"},
              "placement": {"type": "string"},
              "typography": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["asset_id", "role"],
            "properties": {
              "asset_id": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "preserve": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "change": {"type": "array", "items": {"type": "string"}},
        "preserve": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "exclude": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "inspection": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rights": {
      "type": "object",
      "required": ["status", "notes"],
      "properties": {
        "status": {"enum": ["CLEARED", "LIMITED", "REJECTED", "UNVERIFIED"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
