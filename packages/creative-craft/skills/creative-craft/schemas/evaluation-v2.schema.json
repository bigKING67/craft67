{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/creative-craft/schemas/evaluation-v2.schema.json",
  "title": "Creative Craft Evaluation v2",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "target_ref", "stage", "brief_id", "dimensions", "recommendation", "remaining_unknowns"],
  "properties": {
    "schema_version": {"const": "creative-craft.evaluation.v2"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "pattern": "^cc://"},
    "stage": {"enum": ["route", "direction", "output", "delivery"]},
    "brief_id": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "weight", "score", "evidence_state", "evidence_refs", "rationale"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "score": {"type": "number", "minimum": 0, "maximum": 5},
          "evidence_state": {"enum": ["SPECIFIED", "OBSERVED", "INFERRED", "HYPOTHESIZED", "UNVERIFIED"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^cc://"}},
          "rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "recommendation": {"type": "string"},
    "remaining_unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
