{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/creative-craft/schemas/source-lock.schema.json",
  "title": "Creative Craft Source Lock v1",
  "type": "object",
  "required": ["schema_version", "verified_at", "sources"],
  "properties": {
    "schema_version": {"const": "creative-craft.sources.v1"},
    "verified_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "authority", "url"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "used_for": {"type": "array", "items": {"type": "string"}},
          "access_note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
