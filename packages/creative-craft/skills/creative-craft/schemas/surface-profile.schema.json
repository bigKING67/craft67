{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/creative-craft/schemas/surface-profile.schema.json",
  "title": "Creative Craft Execution Surface v1",
  "type": "object",
  "required": ["schema_version", "surface_id", "provider", "label", "available", "verified_at", "provider_profiles", "modes", "notes"],
  "properties": {
    "schema_version": {"const": "creative-craft.surface.v1"},
    "surface_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "available": {"type": "boolean"},
    "verified_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "provider_profiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "modes": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
