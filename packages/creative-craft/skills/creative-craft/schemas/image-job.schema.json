{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/creative-craft/schemas/image-job.schema.json",
  "title": "Creative Craft Image Job v1",
  "type": "object",
  "required": ["schema_version", "job_id", "brief_id", "status", "provider_profile", "task_type", "execution_mode", "intended_use", "canvas", "prompt", "inspection", "rights"],
  "properties": {
    "schema_version": {"const": "creative-craft.image-job.v1"},
    "job_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "ready", "executed", "inspected", "approved", "superseded"]},
    "provider_profile": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["generate", "edit"]},
    "execution_mode": {"enum": ["single_turn", "multi_turn"]},
    "intended_use": {"type": "string", "minLength": 1},
    "canvas": {
      "type": "object",
      "required": ["size", "quality", "format", "compression", "background", "variants"],
      "properties": {
        "size": {"type": "string", "minLength": 1},
        "quality": {"enum": ["low", "medium", "high", "auto"]},
        "format": {"enum": ["png", "jpeg", "webp"]},
        "compression": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "JPEG/WebP output compression percentage; null means provider default."
        },
        "background": {"enum": ["opaque", "auto"]},
        "variants": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "required": ["scene", "subject", "composition", "lighting", "materials_style", "exact_text", "references", "change", "preserve", "constraints", "exclude"],
      "properties": {
        "scene": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "action": {"type": "string"},
        "composition": {"type": "string", "minLength": 1},
        "lighting": {"type": "string", "minLength": 1},
        "materials_style": {"type": "string", "minLength": 1},
        "exact_text": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {"text": {"type": "string"}, "placement": {"type": "string"}, "typography": {"type": "string"}},
            "additionalProperties": false
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["asset_id", "role"],
            "properties": {
              "asset_id": {"type": "string"},
              "role": {"type": "string"},
              "preserve": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "change": {"type": "array", "items": {"type": "string"}},
        "preserve": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "exclude": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "inspection": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rights": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["CLEARED", "LIMITED", "REJECTED", "UNVERIFIED"]}, "notes": {"type": "string"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
