{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigking67.github.io/review-craft/schemas/config.schema.json",
  "title": "Review Craft configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "profile", "focusDimensions", "diffBase", "scope", "exclude", "generated", "vendored", "commands", "policy", "reportLanguage"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "mode": {"enum": ["review", "diff", "focus"]},
    "assuranceLevel": {"enum": ["fast", "standard", "assured"]},
    "profile": {"enum": ["auto", "generic", "application", "desktop-app", "frontend", "backend-service", "library", "cli", "monorepo", "agent-project", "data-pipeline"]},
    "focusDimensions": {
      "type": "array",
      "items": {"enum": ["correctness", "architecture", "maintainability", "performance", "codeQuality", "testing", "dependenciesSecurity", "repositoryExperience"]}
    },
    "diffBase": {"type": ["string", "null"], "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "generated": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "vendored": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "timeoutSeconds": {"type": "integer", "minimum": 1},
          "evidenceClaims": {
            "type": "array",
            "maxItems": 32,
            "items": {"$ref": "#/$defs/evidenceClaim"}
          },
          "artifacts": {
            "type": "array",
            "maxItems": 16,
            "items": {"$ref": "#/$defs/evidenceArtifact"}
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowNetwork": {
          "type": "boolean",
          "description": "A declarative host/agent policy. The Review Craft runtime does not enforce network isolation."
        },
        "allowInstall": {
          "type": "boolean",
          "description": "A declarative host/agent policy. The Review Craft runtime does not enforce installation isolation."
        },
        "allowRepositoryMutation": {
          "type": "boolean",
          "description": "Controls the runner response after before/after source fingerprints detect a repository mutation; it does not prevent writes."
        },
        "outputOutsideRepository": {
          "type": "boolean",
          "description": "Enforced by preflight when resolving the run output directory."
        }
      }
    },
    "reportLanguage": {"const": "zh-CN"}
  },
  "$defs": {
    "evidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "jsonPointer", "equals"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "kind": {"enum": ["check", "test", "build", "package", "isolated-install", "runtime", "benchmark", "profile", "trace", "clean-deployment-reproduction"]},
        "jsonPointer": {"type": "string", "minLength": 1},
        "equals": {"type": ["string", "number", "boolean", "null"]}
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pathJsonPointer"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "pathJsonPointer": {"type": "string", "minLength": 1},
        "sha256JsonPointer": {"type": "string", "minLength": 1},
        "sizeBytesJsonPointer": {"type": "string", "minLength": 1},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    }
  }
}
