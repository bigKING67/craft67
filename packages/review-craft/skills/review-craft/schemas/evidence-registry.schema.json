{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigking67.github.io/review-craft/schemas/evidence-registry.schema.json",
  "title": "Review Craft registered evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "artifacts"],
  "properties": {
    "documentType": {"const": "review-craft.evidence-registry"},
    "schemaVersion": {"enum": ["review-craft.run.v4", "review-craft.run.v5"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "sha256", "sizeBytes", "mediaType", "producer", "description", "registeredAt"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "kind": {"enum": ["source", "check", "test", "build", "runtime", "benchmark", "profile", "trace", "verification", "other"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sizeBytes": {"type": "integer", "minimum": 0},
          "mediaType": {"type": "string", "minLength": 1},
          "producer": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "registeredAt": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
