{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigking67.github.io/review-craft/schemas/dependency-map.schema.json",
  "title": "Best-effort repository dependency map",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "filesAnalyzed", "filesSkipped", "edges", "moduleEdges", "limitations"],
  "properties": {
    "documentType": {"const": "review-craft.dependency-map"},
    "schemaVersion": {"enum": ["review-craft.run.v3", "review-craft.run.v4", "review-craft.run.v5"]},
    "filesAnalyzed": {"type": "integer", "minimum": 0},
    "filesSkipped": {"type": "array", "items": {"$ref": "#/$defs/skipped"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "moduleEdges": {"type": "array", "items": {"$ref": "#/$defs/moduleEdge"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "line"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "kind": {"enum": ["python-import", "javascript-import"]},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "moduleEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "count"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
