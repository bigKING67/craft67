{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigking67.github.io/review-craft/schemas/command-receipt.schema.json",
  "title": "Evidence command receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sequence", "name", "argv", "cwd", "startedAt", "durationMs", "exitCode", "timedOut", "stdoutArtifact", "stderrArtifact", "stdoutSha256", "stderrSha256", "beforeStatusSha256", "afterStatusSha256", "repositoryMutationDetected"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "sequence": {"type": "integer", "minimum": 0},
    "name": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cwd": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "durationMs": {"type": "integer", "minimum": 0},
    "exitCode": {"type": "integer"},
    "timedOut": {"type": "boolean"},
    "stdoutArtifact": {"type": "string", "minLength": 1},
    "stderrArtifact": {"type": "string", "minLength": 1},
    "stdoutSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stderrSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "beforeStatusSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "afterStatusSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repositoryMutationDetected": {"type": "boolean"},
    "semanticEvidenceValid": {"type": "boolean"},
    "evidenceClaims": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/evidenceClaimResult"}
    },
    "evidenceArtifacts": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/evidenceArtifactResult"}
    }
  },
  "$defs": {
    "evidenceClaimResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "kind": {"enum": ["check", "test", "build", "package", "isolated-install", "runtime", "benchmark", "profile", "trace", "clean-deployment-reproduction"]},
        "status": {"enum": ["VERIFIED", "UNVERIFIED"]}
      }
    },
    "evidenceArtifactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "sourcePath", "storedArtifact", "sha256", "sizeBytes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "status": {"enum": ["VERIFIED", "INVALID_OUTPUT", "MISSING", "REJECTED", "TOO_LARGE", "MISMATCH"]},
        "sourcePath": {"type": ["string", "null"]},
        "storedArtifact": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
