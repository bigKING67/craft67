{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigking67.github.io/review-craft/schemas/fix-verification.schema.json",
  "title": "Review Craft fix verification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "toolVersion", "fixId", "verifiedAt", "planSha256", "assessmentSha256", "status", "sourceChanged", "current", "changes", "commands", "skippedCommands", "findingResults", "assessmentKind", "remainingRisks"],
  "properties": {
    "documentType": {"const": "review-craft.fix-verification"},
    "schemaVersion": {"const": "review-craft.fix.v1"},
    "toolVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "fixId": {"type": "string", "minLength": 1},
    "verifiedAt": {"type": "string", "format": "date-time"},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assessmentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["VERIFIED", "PARTIAL", "FAILED", "NO_CHANGES"]},
    "sourceChanged": {"type": "boolean"},
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "branch", "remote", "sourceFingerprint", "worktreeFingerprint", "statusFingerprint"],
      "properties": {
        "revision": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "remote": {"type": ["string", "null"]},
        "sourceFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "worktreeFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "statusFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "beforeSha256", "afterSha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "status": {"enum": ["ADDED", "MODIFIED", "DELETED"]},
          "beforeSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "afterSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "receiptId", "receiptSha256", "exitCode", "timedOut", "repositoryMutationDetected"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "receiptId": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
          "receiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "exitCode": {"type": "integer"},
          "timedOut": {"type": "boolean"},
          "repositoryMutationDetected": {"type": "boolean"},
          "semanticEvidenceValid": {"type": "boolean"}
        }
      }
    },
    "skippedCommands": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "findingResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "status", "rationale", "evidenceRefs", "locationPathsChanged"],
        "properties": {
          "findingId": {"type": "string", "minLength": 1},
          "status": {"enum": ["RESOLVED", "LIKELY_RESOLVED", "PARTIAL", "UNRESOLVED", "REGRESSED", "NOT_APPLICABLE"]},
          "rationale": {"type": "string", "minLength": 1},
          "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "locationPathsChanged": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "assessmentKind": {"enum": ["HUMAN", "AGENT_ASSISTED", "AUTOMATED"]},
    "remainingRisks": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
