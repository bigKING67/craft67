{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigking67.github.io/review-craft/schemas/decisions.schema.json",
  "title": "Review disposition decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "decisions"],
  "properties": {
    "documentType": {"const": "review-craft.decisions"},
    "schemaVersion": {"enum": ["review-craft.run.v3", "review-craft.run.v4", "review-craft.run.v5"]},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "findingRefs", "decision", "rationale", "alternatives", "migration", "compatibilityRisks", "rollback", "verification"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "findingRefs": {"$ref": "#/$defs/strings"},
        "decision": {"enum": ["KEEP", "CLEAN_UP", "MERGE", "REPLACE", "REWRITE", "DELETE", "DEFER", "MEASURE", "DOCUMENT"]},
        "rationale": {"type": "string", "minLength": 1},
        "alternatives": {"$ref": "#/$defs/strings"},
        "migration": {"type": "string"},
        "compatibilityRisks": {"$ref": "#/$defs/strings"},
        "rollback": {"type": "string"},
        "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
