{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigking67.github.io/review-craft/schemas/candidate.schema.json",
  "title": "Review candidate ledger row",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "type", "title", "locations", "evidence", "claimedImpact", "confidence", "validation"],
  "properties": {
    "id": {"type": "string", "pattern": "^RC-[A-Z]+-[0-9]{3,}$"},
    "category": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "locations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/location"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "claimedImpact": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "evidenceRefs", "remainingUncertainty"],
      "properties": {
        "status": {"enum": ["PENDING", "CONFIRMED", "LIKELY", "NEEDS_MEASUREMENT", "BLOCKED", "REJECTED", "NOT_APPLICABLE"]},
        "method": {"type": "string"},
        "evidenceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "remainingUncertainty": {"type": "string"}
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lineStart", "lineEnd", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "lineStart": {"type": "integer", "minimum": 1},
        "lineEnd": {"type": "integer", "minimum": 1},
        "role": {"type": "string", "minLength": 1},
        "anchor": {"$ref": "#/$defs/anchor"}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sourceSide", "sourceSha256", "sourceLineCount", "spanSha256"],
      "properties": {
        "algorithm": {"const": "sha256-raw-lines-v1"},
        "sourceSide": {"enum": ["CURRENT", "BASE"]},
        "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sourceLineCount": {"type": "integer", "minimum": 1},
        "spanSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "summary"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
