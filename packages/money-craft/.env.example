# Money Craft source-development overrides only.
#
# Copy this file to .env.local, set mode 0600, and select it explicitly:
#   export MONEY_CRAFT_ENV_FILE="$PWD/.env.local"
# Installed Skill copies do not search the current directory or parent folders.

# Optional provider credentials. Never commit real values.
FUYAO_API_KEY=
FRED_API_KEY=

# Optional app-specific absolute directories. The defaults follow XDG:
#   config: ~/.config/money-craft
#   data:   ~/.local/share/money-craft
#   cache:  ~/.cache/money-craft
MONEY_CRAFT_CONFIG_HOME=
MONEY_CRAFT_DATA_HOME=
MONEY_CRAFT_CACHE_HOME=

# Optional controlled interpreter and research-output overrides.
MONEY_CRAFT_DATA_PYTHON=
MONEY_CRAFT_REPORT_PYTHON=
MONEY_CRAFT_OUTPUT_ROOT=
