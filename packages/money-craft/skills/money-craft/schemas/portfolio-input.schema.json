{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "money-craft.portfolio-input.v1",
  "title": "Source-bound long-only portfolio input",
  "description": "Structural contract. Runtime additionally checks Decimal precision/ranges, dates, identities, sums, source hashes, consistent snapshot dates and exact scenario keys.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "money-craft.portfolio-input.v1"
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "base_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "principal": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]{1,18})?$",
      "maxLength": 36,
      "description": "Plain Decimal string, at most 34 total digits. Runtime checks numeric ranges."
    },
    "assumption_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "max_loss": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]{1,18})?$",
      "maxLength": 36,
      "description": "Plain Decimal string, at most 34 total digits. Runtime checks numeric ranges."
    },
    "max_issuer_weight": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]{1,18})?$",
      "maxLength": 36,
      "description": "Plain Decimal string, at most 34 total digits. Runtime checks numeric ranges."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "fund_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^https://",
            "format": "uri"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "id",
          "fund_id",
          "path",
          "sha256",
          "url",
          "as_of"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "funds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$"
          },
          "quote_currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "weight": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]{1,18})?$",
            "maxLength": 36,
            "description": "Plain Decimal string, at most 34 total digits. Runtime checks numeric ranges."
          },
          "fee": {
            "type": "object",
            "properties": {
              "rate": {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]{1,18})?$",
                "maxLength": 36,
                "description": "Plain Decimal string, at most 34 total digits. Runtime checks numeric ranges."
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
              }
            },
            "required": [
              "rate",
              "source_id",
              "locator"
            ],
            "additionalProperties": false
          },
          "holdings": {
            "type": "object",
            "properties": {
              "coverage": {
                "enum": [
                  "partial",
                  "complete"
                ]
              },
              "as_of": {
                "type": "string",
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
              },
              "positions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "security_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                    },
                    "issuer_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                    },
                    "weight": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(?:\\.[0-9]{1,18})?$",
                      "maxLength": 36,
                      "description": "Plain Decimal string, at most 34 total digits. Runtime checks numeric ranges."
                    }
                  },
                  "required": [
                    "security_id",
                    "issuer_id",
                    "weight"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 20000
              }
            },
            "required": [
              "coverage",
              "as_of",
              "source_id",
              "locator",
              "positions"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "quote_currency",
          "weight",
          "fee",
          "holdings"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 50
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "assumption_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "asset_returns": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]{1,18})?$",
              "maxLength": 36,
              "description": "Plain Decimal string, at most 34 total digits. Runtime checks numeric ranges."
            }
          },
          "fx_returns": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^-?[0-9]+(?:\\.[0-9]{1,18})?$",
              "maxLength": 36,
              "description": "Plain Decimal string, at most 34 total digits. Runtime checks numeric ranges."
            }
          }
        },
        "required": [
          "id",
          "assumption_note",
          "asset_returns",
          "fx_returns"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schema",
    "as_of",
    "base_currency",
    "principal",
    "assumption_note",
    "max_loss",
    "max_issuer_weight",
    "sources",
    "funds",
    "scenarios"
  ],
  "additionalProperties": false
}
