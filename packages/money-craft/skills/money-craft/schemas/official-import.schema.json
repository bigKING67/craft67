{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/money-craft/schemas/official-import.schema.json",
  "title": "Money Craft official source import",
  "type": "object",
  "required": [
    "schema",
    "valid",
    "source_id",
    "kind",
    "title",
    "url",
    "retrieved_on",
    "local_path",
    "sha256",
    "bytes"
  ],
  "properties": {
    "schema": {"const": "money-craft.official-import.v1"},
    "valid": {"const": true},
    "source_id": {"type": "string", "pattern": "^S[0-9]{2,4}$"},
    "kind": {"enum": ["official-document", "official-index"]},
    "title": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "retrieved_on": {"type": "string", "format": "date"},
    "local_path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
