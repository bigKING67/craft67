{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/money-craft/schemas/thesis-update-plan.schema.json",
  "title": "Money Craft thesis update plan",
  "type": "object",
  "required": [
    "schema",
    "identity",
    "previous",
    "target",
    "hypotheses",
    "red_lines",
    "preserved_update_history",
    "existing_source_ids",
    "required_actions",
    "completion_gate",
    "previous_audits"
  ],
  "properties": {
    "schema": {"const": "money-craft.thesis-update-plan.v1"},
    "identity": {"type": "object"},
    "previous": {"type": "object"},
    "target": {"type": "object"},
    "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "red_lines": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "preserved_update_history": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "existing_source_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "required_actions": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "completion_gate": {"type": "object"},
    "previous_audits": {"type": "object"}
  },
  "additionalProperties": false
}
