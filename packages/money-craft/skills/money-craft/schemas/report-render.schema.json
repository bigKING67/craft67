{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/money-craft/schemas/report-render.schema.json",
  "title": "Money Craft report rendition",
  "type": "object",
  "required": [
    "schema",
    "valid",
    "source",
    "source_sha256",
    "template",
    "template_sha256",
    "style",
    "style_sha256",
    "script",
    "script_sha256",
    "theme",
    "theme_label",
    "layout_mode",
    "portable_html",
    "title",
    "html",
    "pdf",
    "pages",
    "html_bytes",
    "pdf_bytes",
    "placeholders",
    "external_dependencies",
    "charts",
    "network_used"
  ],
  "properties": {
    "schema": {"const": "money-craft.report-render.v1"},
    "valid": {"const": true},
    "source": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "template": {"type": "string"},
    "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "style": {"type": "string"},
    "style_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "script": {"type": "string"},
    "script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "theme": {"const": "editorial-ivory"},
    "requested_theme": {"type": "string"},
    "theme_label": {"const": "Money Craft Editorial Ivory"},
    "layout_mode": {"const": "research-publication"},
    "portable_html": {"const": true},
    "title": {"type": "string", "minLength": 1},
    "html": {"type": "string"},
    "pdf": {"type": ["string", "null"]},
    "pages": {"type": ["integer", "null"], "minimum": 1},
    "html_bytes": {"type": "integer", "minimum": 1},
    "pdf_bytes": {"type": ["integer", "null"], "minimum": 1},
    "placeholders": {"const": 0},
    "external_dependencies": {"const": 0},
    "charts": {"type": "integer", "minimum": 0},
    "network_used": {"const": false}
  },
  "additionalProperties": false
}
